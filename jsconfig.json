{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "maxNodeModuleJsDepth": 0,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "index.html",
    "eslint.config.js",
    "playwright.config.js",
    "tests/**/*.js",
    "tests/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    "evidence/performance"
  ]
}
